{
  "name": "estudio-series",
  "version": "0.1.0",
  "private": true,
  "description": "Estúdio de Séries: minisséries verticais com IA (OpenRouter) e escolhas A/B",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "node scripts/dev.js",
