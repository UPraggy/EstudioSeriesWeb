      "volume": 0.85,
      "pausaAntesS": 0.4, "pausaDepoisS": 0.45, "pausaFrasesS": 0.5,
      "filtro": "aecho=0.8:0.7:45|90:0.3|0.15,lowpass=f=7500"
    },
    "apresentador": {
      "nome": "Apresentador",
      "uso": "narrador na tela falando com o público (abertura, CTA 'Comente A ou B')",
      "edge": { "tom": "+1Hz", "velocidade": "+2%" },
      "piper": { "tom": "+0.5st", "velocidade": "+2%" },
      "volume": 1.0,
      "pausaAntesS": 0.25, "pausaDepoisS": 0.3, "pausaFrasesS": 0.35,
      "filtro": "equalizer=f=3000:t=q:w=1.2:g=2"
    }
  },
  "apelidos": {
    "narracao-suspense": "narracao_suspense",
