      "piper": { "tom": "-1st", "velocidade": "-12%" },
      "volume": 0.7,
      "pausaAntesS": 0.35, "pausaDepoisS": 0.4, "pausaFrasesS": 0.45,
      "filtro": "highpass=f=150,highshelf=f=4500:g=3,acompressor=threshold=-24dB:ratio=3:attack=5:release=120:makeup=2"
    },
    "grito_urgencia": {
      "nome": "Grito / urgência",
      "uso": "alerta, ordem, correria: mais agudo e rápido, pausas curtas",
