      "piper": { "tom": "+1.5st", "velocidade": "+8%" },
      "volume": 1.25,
      "pausaAntesS": 0.1, "pausaDepoisS": 0.2, "pausaFrasesS": 0.15,
      "filtro": "acompressor=threshold=-16dB:ratio=4:attack=3:release=80:makeup=2,highshelf=f=2500:g=2"
