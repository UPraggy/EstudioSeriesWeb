      "pausaAntesS": 0.35, "pausaDepoisS": 0.35, "pausaFrasesS": 0.5,
      "filtro": "vibrato=f=5.5:d=0.05,tremolo=f=5.5:d=0.12"
    },
    "cansaco": {
      "nome": "Cansaço",
      "uso": "exausto, ferido, sem forças: grave, lento, abafado",
