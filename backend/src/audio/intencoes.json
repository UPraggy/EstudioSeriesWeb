{
  "versao": 1,
  "_doc": [
    "INTENCOES de fala do Estudio de Series (docs/AUDIO.md). Cada intencao vira tom, velocidade, volume, pausas e filtro ffmpeg.",
    "tom e velocidade da intencao sao AJUSTES somados a base (papel no projeto > padrao da voz em vozes.json); 'tom'/'velocidade' escritos na fala sao absolutos e vencem tudo.",
    "Edge: tom em Hz inteiro, velocidade em % inteiro. Piper: tom em semitons (st), velocidade em % (vira length_scale no motor).",
    "volume da intencao MULTIPLICA o volume do papel/voz (o Cadu ja tem 1,3 em vozes.json). No tratamento vira o alvo de loudness da fala: -16 LUFS + 20*log10(volume / volume padrao da voz).",
    "pausaAntesS/pausaDepoisS = silencio antes/depois da fala; pausaFrasesS = respiro entre as frases de uma fala longa, vezes o fator da pontuacao.",
    "filtro = cadeia de audio do ffmpeg aplicada pelo motor na fala (antes do volume). '' = sem filtro.",
    "Limite natural: Edge +-10 Hz, Piper +-2 st (alem disso vira caricatura); velocidade -25% a +20%; volume 0,3 a 2,0."
  ],
  "limites": {
    "edge": { "tom": 10, "unidade": "Hz" },
    "piper": { "tom": 2, "unidade": "st" },
    "velocidade": [-25, 20],
    "volume": [0.3, 2.0],
    "hzPorSemitom": 6
  },
  "frases": {
    "maxPalavras": 12,
    "maxPalavrasFrase": 20,
    "pontuacao": { ".": 1.0, "!": 0.8, "?": 1.0, "…": 1.6, "...": 1.6, ";": 0.7, ":": 0.6, ",": 0.5 }
  },
  "intencoes": {
    "neutra": {
      "nome": "Neutra",
      "uso": "fala comum em cena",
      "edge": { "tom": "+0Hz", "velocidade": "+0%" },
      "piper": { "tom": "+0st", "velocidade": "+0%" },
      "volume": 1.0,
      "pausaAntesS": 0.3, "pausaDepoisS": 0.3, "pausaFrasesS": 0.35,
      "filtro": ""
    },
    "narracao_suspense": {
      "nome": "Narração de suspense",
      "uso": "narrador contando a história: mais grave, mais lento, respiros longos",
      "edge": { "tom": "-2Hz", "velocidade": "-7%" },
      "piper": { "tom": "-0.5st", "velocidade": "-7%" },
      "volume": 0.95,
      "pausaAntesS": 0.4, "pausaDepoisS": 0.5, "pausaFrasesS": 0.55,
      "filtro": "lowshelf=f=160:g=2"
    },
    "sussurro": {
      "nome": "Sussurro",
      "uso": "segredo, perigo perto: baixo, lento, com ar",
